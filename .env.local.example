# Copiare in .env.local e riempire con i valori veri.
# .env.local sta fuori da git: su ogni macchina nuova va rifatto a mano.
# Supabase → Project Settings › API

NEXT_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# Scavalca ogni regola di sicurezza: resta sul server e non prende mai
# il prefisso NEXT_PUBLIC_, che la manderebbe dritta nel browser.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
