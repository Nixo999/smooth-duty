# Copiare in .env.db e riempire.
# Serve solo agli script che parlano direttamente con Postgres
# (verifica-schema, esegui-sql, verifica-riservatezza): l'API REST di
# Supabase non sa creare tabelle.
# Supabase → Project Settings › Database › Database password

SUPABASE_DB_PASSWORD=<password del database>
